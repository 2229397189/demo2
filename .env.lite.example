# ============================================================
#  AGI Assistant 轻量部署配置（低配服务器 ≤2G 内存专用）
#  用法：cp .env.lite.example .env  然后填写真实值
#  适用：docs/server-lite-deploy.md 描述的「不跑 Docker 中间件」方案
#
#  与 .env.prod.example 的区别：关闭 Milvus / Neo4j / Kafka / ES / Docker 沙箱，
#  复用宿主机已有的 Redis，MySQL 用宿主机原生安装（非容器）。
#  应用自身的优雅降级会兜底，文档状态将如实显示为 PARTIAL 而非假 COMPLETED。
# ============================================================

# ---------- 数据库（宿主机原生 MySQL）----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=agi_assistant
DB_USERNAME=root
DB_PASSWORD=请改成强密码

# ---------- Redis（复用宿主机已有实例，无需容器）----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- 关闭重中间件（低配必需）----------
# Milvus 向量检索：关闭后 DENSE 召回跳过，混合检索退化为可用路
MILVUS_ENABLED=false
# Neo4j 知识图谱：关闭后图谱检索恒空、图记忆跳过
NEO4J_ENABLED=false
# Kafka 审计通道：关闭后审计走 DB 主写 + 本地日志（这就是主路径，不影响功能）
KAFKA_ENABLED=false

# ---------- RAG 基础设施 ----------
# Milvus/ES 都不可用，初始化器无需开启（开了也只是尝试后失败）
RAG_INITIALIZER_ENABLED=false
RAG_GRAPH_EXTRACTION_ENABLED=false
ES_INDEX_ANALYZER=standard
ES_SEARCH_ANALYZER=standard

# ---------- 沙箱（低配建议关闭）----------
SANDBOX_ENABLED=false
SANDBOX_REQUIRE_CONFIRM=true

# ---------- LLM（智谱 GLM）----------
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_API_KEY=请填写智谱APIKey
OPENAI_MODEL=glm-4.5-air
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7
OPENAI_TIMEOUT=120
OPENAI_CONNECT_TIMEOUT=30
OPENAI_THINKING=disabled
LLM_PROVIDER=glm

# ---------- 火山方舟 Ark（可选，默认关）----------
ARK_ENABLED=false
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
ARK_MODEL=doubao-seed-2-0-pro-260215

# ---------- Embedding（阿里云百炼 DashScope）----------
# 注意：Milvus 关闭时向量召回不生效，但 embedding 仍用于 Answer Relevancy 等指标计算
EMBEDDING_PROVIDER=auto
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=请填写DashScope APIKey
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024

# ---------- 鉴权 ----------
AUTH_ENABLED=true
JWT_SECRET=请改成一个至少32字节的随机字符串
JWT_EXPIRE_HOURS=168

# ---------- 记忆生命周期 ----------
MEMORY_DECAY_ENABLED=true
MEMORY_DECAY_CRON=0 0 3 * * ?

# ---------- 对话行为 ----------
CHAT_AUTO_EXECUTE_CODE=false
CHAT_REACT_MIN_LENGTH=300
PLAN_USE_LLM=true

# ---------- 上传 ----------
UPLOAD_DIR=./uploads
