# ============================================================
#  AGI Assistant 服务器生产配置模板
#  用法：复制为 .env 并填入真实值（.env 已在 .gitignore，绝不提交）
#      cp .env.prod.example .env
#  然后：docker compose -f docker-compose.prod.yml up -d
#
#  ⚠️ 关键机制（务必理解，否则会踩坑）：
#  application.yml 用 `spring.config.import: optional:file:.env[.properties]`
#  把 .env 当 properties 文件加载，且是「相对路径」——容器内后端的工作目录
#  是 /app，.env 由 compose 的 env_file 注入到容器环境变量，故这里用 UPPER_SNAKE。
#  ⚠️ 死配置陷阱：任何键若在 application.yml 里没有对应的 ${KEY:default} 占位，
#  它就是死配置（填了不生效且不报错）。请对照 application.yml 逐项确认。
# ============================================================

# ---------- 数据库 ----------
DB_HOST=mysql
DB_PORT=3306
DB_NAME=agi_assistant
DB_USERNAME=root
DB_PASSWORD=请改成强密码
# compose 里 mysql 容器的 root 密码，必须与上面 DB_PASSWORD 一致
MYSQL_ROOT_PASSWORD=请改成强密码

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis123456

# ---------- Kafka（审计通道）----------
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# 容器内 broker 对外通告地址（宿主机的后端/外部访问用）；纯 compose 部署保持 127.0.0.1 即可
KAFKA_ADVERTISED_HOST=127.0.0.1

# ---------- Milvus（向量检索）----------
MILVUS_ENABLED=true
MILVUS_HOST=milvus-standalone
MILVUS_PORT=19530
MILVUS_DATABASE=default

# ---------- Elasticsearch（BM25）----------
# 注意：compose 把容器 9200 映射到宿主 9201；容器内后端直连 9200
ELASTICSEARCH_URIS=elasticsearch:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ---------- Neo4j（知识图谱）----------
NEO4J_ENABLED=true
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j123456

# ---------- RAG 基础设施初始化（必须 true，否则 Milvus collection / ES mapping 永不创建）----------
RAG_INITIALIZER_ENABLED=true
ES_INDEX_ANALYZER=standard
ES_SEARCH_ANALYZER=standard
RAG_GRAPH_EXTRACTION_ENABLED=true
RAG_GRAPH_EXTRACTION_MAX_CHUNKS=40

# ---------- LLM（智谱 GLM）----------
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_API_KEY=请填写智谱APIKey
OPENAI_MODEL=glm-4.5-air
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7
OPENAI_TIMEOUT=120
OPENAI_CONNECT_TIMEOUT=30
OPENAI_THINKING=disabled
# 主 provider：glm / ark
LLM_PROVIDER=glm

# ---------- 火山方舟 Ark（豆包，可选）----------
# 实测 2026-09-17：账号仅开通 doubao-seed-2-0-pro-260215；
# doubao-seed-2-0-lite 与 doubao-embedding-large 需先到方舟控制台开通。
ARK_ENABLED=false
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
ARK_MODEL=doubao-seed-2-0-pro-260215
ARK_TIMEOUT=120
ARK_CONNECT_TIMEOUT=30

# ---------- Embedding（阿里云百炼 DashScope）----------
EMBEDDING_PROVIDER=auto
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=请填写DashScope APIKey
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024

# ---------- 鉴权（生产必须 true，否则接口无鉴权裸奔）----------
AUTH_ENABLED=true
JWT_SECRET=请改成一个至少32字节的随机字符串
JWT_EXPIRE_HOURS=168

# ---------- 记忆生命周期 ----------
MEMORY_DECAY_ENABLED=true
MEMORY_DECAY_CRON=0 0 3 * * ?

# ---------- 对话行为 ----------
CHAT_AUTO_EXECUTE_CODE=false
CHAT_REACT_MIN_LENGTH=300
PLAN_USE_LLM=true

# ---------- 上传 ----------
UPLOAD_DIR=./uploads

# ---------- Docker 沙箱 ----------
# 生产建议开启确认门槛，避免 LLM 无确认触发沙箱执行
SANDBOX_ENABLED=true
SANDBOX_REQUIRE_CONFIRM=true
SANDBOX_NETWORK_DISABLED=true
SANDBOX_READONLY_FS=true
SANDBOX_TMPFS=256m
SANDBOX_PYTHON_IMAGE=python:3.11-slim
SANDBOX_NODE_IMAGE=node:20-slim
SANDBOX_JAVA_IMAGE=eclipse-temurin:17-jdk
SANDBOX_TIMEOUT=60
SANDBOX_MEMORY=512m
SANDBOX_CPU=1.0
# 注意：后端容器若要用 Docker 沙箱，需要能访问宿主机的 docker.sock
# 生产环境建议给 backend 挂载 /var/run/docker.sock，或改用远程 docker host。
# 如暂时不用沙箱，SANDBOX_ENABLED=false 即可。
DOCKER_HOST=unix:///var/run/docker.sock
