# ============================================================
#  AGI Assistant 环境变量模板
#  用法：复制为 .env 并填写真实值（.env 已在 .gitignore 中）
#      cp .env.example .env
# ============================================================

# ---------- MySQL ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=agi_assistant
DB_USERNAME=root
DB_PASSWORD=123456

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- Kafka（审计日志异步通道）----------
# KAFKA_ENABLED=false 时 AuditService 自动降级为本地日志，不影响业务
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ---------- Milvus（向量检索）----------
# 关闭时 Dense 召回自动跳过，Hybrid 退化为 ES 单路
MILVUS_ENABLED=true
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_DATABASE=default

# ---------- Elasticsearch（BM25 稀疏检索）----------
# 注意：docker-compose 把容器 9200 映射到宿主机 9201
ELASTICSEARCH_URIS=localhost:9201
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ---------- Neo4j（知识图谱 / 图记忆）----------
# 关闭时图谱检索与图记忆全部静默跳过
NEO4J_ENABLED=true
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j123456
NEO4J_MAX_CONNECTION_POOL_SIZE=5
NEO4J_CONNECTION_ACQUISITION_TIMEOUT=5

# ---------- RAG 基础设施初始化 ----------
# 必须为 true，否则 Milvus collection 与 ES index mapping 不会被创建
RAG_INITIALIZER_ENABLED=true
# 装了 analysis-ik 插件后可改为 ik_max_word / ik_smart
ES_INDEX_ANALYZER=standard
ES_SEARCH_ANALYZER=standard

# ---------- 知识图谱构建（Neo4j）----------
# 文档入库时抽取实体并建立 Entity/DocumentChunk 节点与 MENTIONS 边。
# 每篇文档按 max-chunks 规模触发若干次 LLM 抽取调用，成本敏感可置 false。
RAG_GRAPH_EXTRACTION_ENABLED=true
RAG_GRAPH_EXTRACTION_MAX_CHUNKS=40

# ---------- LLM（智谱 GLM，OpenAI 兼容协议）----------
# 实测 glm-4.5-air / glm-4.6v 可用，默认开启思维链；
# OPENAI_THINKING=disabled 可关闭思维链，显著降低延迟与 token 消耗。
# 注意：API Key 是「id.secret」两段式，中间那个点不能漏。
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_API_KEY=请填写智谱APIKey（格式 id.secret）
OPENAI_MODEL=glm-4.5-air
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7
OPENAI_TIMEOUT=120
OPENAI_CONNECT_TIMEOUT=30
OPENAI_THINKING=disabled

# ---------- Embedding（阿里云百炼 DashScope text-embedding-v3）----------
# 为什么不用智谱：智谱赠送资源包仅覆盖推理，embedding 调用返回
#   code=1113「余额不足或无可用资源包」，故 embedding 单独走 DashScope。
# dimensions 必须与 Milvus collection 向量维度一致，改动后需重建 collection。
# provider: remote=仅远程 / local=仅本地哈希降级 / auto=远程失败自动降级
EMBEDDING_PROVIDER=auto
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=请填写DashScope APIKey（sk- 开头）
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024

# ---------- 鉴权 ----------
# 生产环境务必修改 jwt-secret
JWT_SECRET=agi-assistant-dev-secret-please-change-in-production-0123456789
JWT_EXPIRE_HOURS=168
AUTH_ENABLED=true

# ---------- 记忆生命周期 ----------
MEMORY_DECAY_ENABLED=true
MEMORY_DECAY_CRON=0 0 3 * * ?

# ---------- 对话行为 ----------
# 自动执行 LLM 回答中的代码块（有资源与安全成本）
CHAT_AUTO_EXECUTE_CODE=false
# 触发 ReAct 的最小消息长度
CHAT_REACT_MIN_LENGTH=300

# ---------- Agent 规划（ReAct Planner）----------
# 是否用 LLM 把用户问题分解为有序执行步骤（写入运行态 Planner State）。
# 关闭或 LLM 不可用/解析失败时自动回退启发式计划，计划永不为空。
# 注意：对应 application.yml 里的 agent.plan.use-llm（该键已在 yml 显式占位）。
PLAN_USE_LLM=true

# ---------- 文件上传 ----------
UPLOAD_DIR=./uploads

# ---------- Docker / 沙箱 ----------
DOCKER_HOST=unix:///var/run/docker.sock
# 容器安全策略（默认已最严；仅在有明确需要时才放开）
SANDBOX_ENABLED=true
SANDBOX_REQUIRE_CONFIRM=false
SANDBOX_NETWORK_DISABLED=true
SANDBOX_READONLY_FS=true
SANDBOX_TMPFS=256m
SANDBOX_PYTHON_IMAGE=python:3.11-slim
SANDBOX_NODE_IMAGE=node:20-slim
SANDBOX_JAVA_IMAGE=eclipse-temurin:17-jdk
SANDBOX_TIMEOUT=60
SANDBOX_MEMORY=512m
SANDBOX_CPU=1.0

# ---------- 模型 Provider 选择 & 火山方舟 Ark（可选）----------
# 没有方舟 key 时保持 ARK_ENABLED=false，代码会优雅降级：
#   ArkModelProvider 呈现为不可用，ModelProviderRouter 自动回退 GLM，不影响启动。
# ARK_MODEL 填方舟的接入点(endpoint) id，例如 ep-20240xxx；
# llm.provider 可选 glm / ark，非法值回退 glm。
LLM_PROVIDER=glm
ARK_ENABLED=false
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
ARK_MODEL=
